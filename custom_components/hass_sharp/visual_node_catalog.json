  "edgeKinds": {
    "execution": {
      "required": [
        "id",
        "source",
        "target"
      ],
      "optional": [
        "kind",
        "port"
      ],
      "defaultKind": "execution",
      "defaultPort": "next",
      "description": "Schedules the next node; condition next aliases true."
    },
    "data": {
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "sourcePort",
        "targetPort"
      ],
      "schedulesDependencies": false,
      "maxSourcesPerInput": 1,
      "maxConsumersPerOutput": null,
      "description": "Reads an already-produced value from the current scope snapshot; never executes its source."
    }
  },
  "structures": {
    "loopDeclaration": {
      "name": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
        "required": true
      },
      "type": {
        "type": "string",
        "enumSource": "types",
        "required": true
      },
      "initial": {
        "types": [
          "$type"
        ],
        "required": true,
        "description": "Initial value required even for zero iterations."
      }
    },
    "branchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "unique": true
    },
    "operand": {
      "literal": {
        "required": [
          "kind",
          "type",
          "value"
        ],
        "types": [
          "boolean",
          "number",
          "string",
          "object",
          "array",
          "entity_id",
          "target"
        ],
        "constraintsSource": "types",
        "description": "Resolve each type in types: non-null values must satisfy literalKind and its pattern, numeric bounds, character or enumValues constraints. Null requires nullable=true. Types without literalKind accept only null when nullable; arbitrary CLR classes do not accept object JSON."
      },
      "variable": {
        "required": [
          "kind",
          "name"
        ],
        "scope": "same or ancestor snapshot"
      },
      "unset": {
        "required": [
          "kind"
        ],
        "description": "No active literal or reference; connecting and disconnecting never restores an old literal."
      }
    }
  },
  "scopeContract": {
    "maxDepth": 8,
    "conditionPorts": [
      "condition"
    ],
    "bodyPorts": [
      "body"
    ],
    "parallelPortPrefix": "branch:",
    "continuationPort": "next",
    "ancestorReads": "execution snapshot",
    "siblingReads": false,
    "bodyOutputsEscape": false,
    "conditionTerminal": "condition_result",
    "iterationTerminal": "loop_result",
    "loopOutputs": {
      "carry:<name>": "own body or condition descendants",
      "export:<name>": "outside own body and condition; initialized for zero iterations"
    },
    "parallelJoin": "All branch executions complete before next. Branch values, responses and lastError are isolated and never implicitly merged.",
    "loopConditionOrder": {
      "while": "before body",
      "until": "after body"
    }
  }
}
