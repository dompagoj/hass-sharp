    "compare": {
      "label": "Compare",
      "category": "Logic",
      "description": "Compare operands with matching types; ordering requires numbers.",
      "minGraphVersion": 5,
      "config": {
        "operator": {
          "type": "string",
          "required": true,
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge"
          ],
          "default": "eq",
          "description": "Equality or numeric ordering comparison operator.",
          "label": "Operator"
        },
        "output": {
          "type": "string",
          "description": "Optional named variable assigned in addition to the data output; references retain scope isolation.",
          "label": "Output"
        }
      },
      "inputs": {
        "left": {
          "types": [
            "$any"
          ],
          "required": true,
          "description": "First operand; both operands must have matching types.",
          "default": {
            "kind": "literal",
            "type": "number",
            "value": 0
          },
          "label": "Left"
        },
        "right": {
          "types": [
            "$any"
          ],
          "required": true,
          "description": "Second operand; ordering comparisons require numbers.",
          "default": {
            "kind": "literal",
            "type": "number",
            "value": 0
          },
          "label": "Right"
        }
      },
      "outputs": {
        "value": {
          "type": "boolean",
          "description": "Boolean result of the selected comparison.",
          "label": "Result"
        }
      },
      "execution": [
        "next",
        "error"
      ],
      "runtimeVersions": [
        5
      ],
      "comparison": {
        "leftInput": "left",
        "rightInput": "right",
        "operatorConfig": "operator",
        "orderingOperators": [
          "lt",
          "le",
          "gt",
          "ge"
        ],
        "orderingType": "number"
      }
    },
