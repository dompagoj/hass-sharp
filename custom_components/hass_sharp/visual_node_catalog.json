{
  "version": 1,
  "graphVersion": 5,
  "runtimeSupport": "Graph v5 typed execution and structured scopes",
  "limits": {
    "nodes": 256,
    "edges": 512,
    "nesting": 8,
    "executionSteps": 100000,
    "loopIterations": 1000
  },
  "types": {
    "boolean": {
      "description": "Boolean",
      "clrType": "System.Boolean",
      "nullable": false,
      "category": "Boolean",
      "assignableTo": [
        "boolean"
      ],
      "literalKind": "boolean",
      "label": "Boolean"
    },
    "number": {
      "description": "Number",
      "clrType": "System.Double",
      "nullable": false,
      "category": "Number",
      "assignableTo": [
        "number"
      ],
      "literalKind": "number",
      "label": "Number"
    },
    "string": {
      "description": "String",
      "clrType": "System.String",
      "nullable": false,
      "category": "String",
      "assignableTo": [
        "string"
      ],
      "literalKind": "string",
      "label": "String"
    },
    "object": {
      "description": "Object",
      "clrType": "System.Text.Json.Nodes.JsonObject",
      "nullable": false,
      "category": "Object",
      "assignableTo": [
        "object"
      ],
      "literalKind": "object",
      "label": "Object"
    },
    "array": {
      "description": "Array",
      "clrType": "System.Text.Json.Nodes.JsonArray",
      "nullable": false,
      "category": "Array",
      "assignableTo": [
        "array"
      ],
      "literalKind": "array",
      "label": "Array"
    },
    "entity_id": {
      "description": "Entity Id",
      "refines": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "clrType": "System.String",
      "nullable": false,
      "category": "String",
      "assignableTo": [
        "entity_id",
        "string"
      ],
      "literalKind": "string",
      "label": "Entity ID"
    },
    "target": {
      "refines": "object",
      "clrType": "System.Text.Json.Nodes.JsonObject",
      "literalKind": "object",
      "label": "Target",
      "category": "Object",
      "description": "Home Assistant target"
    },
    "global::HassSharp.EntityStateSnapshot": {
      "description": "Detached Home Assistant entity state",
      "clrType": "HassSharp.EntityStateSnapshot",
      "nullable": false,
      "category": "Object",
      "assignableTo": [
        "global::HassSharp.EntityStateSnapshot"
      ]
    }
  },
  "parametricTypes": {
    "entity_id": {
      "param": "^[a-z0-9_]+$",
      "valuePattern": "^{param}\\.[a-z0-9_]+$",
      "label": "{Param} entity"
    }
  },
  "operandKinds": [
    "literal",
    "variable",
    "unset"
  ],
  "nodes": {
    "trigger": {
      "label": "Trigger",
      "category": "Hass",
      "description": "Start an invocation from HA, a legacy trigger, or manual run.",
      "minGraphVersion": 5,
      "config": {
        "type": {
          "type": "string",
          "enum": [
            "entity",
            "daily",
            "once",
            "manual",
            "startup",
            "ha"
          ],
          "default": "entity",
          "description": "Trigger platform selector.",
          "label": "Type"
        },
        "entity": {
          "type": "string",
          "description": "Home Assistant entity ID.",
          "label": "Entity"
        },
        "time": {
          "type": "string",
          "description": "Daily local time in HH:mm format.",
          "label": "Time"
        },
        "timeZone": {
          "type": "string",
          "description": "Explicit IANA/system time zone for daily scheduling.",
          "label": "Time zone"
        },
        "trigger": {
          "type": "object",
          "description": "Native Home Assistant trigger declaration, with trigger or platform and platform-specific options.",
          "label": "Trigger"
        },
        "mode": {
          "type": "string",
          "enum": [
            "Single",
            "Restart",
            "Queued",
            "Parallel"
          ],
          "default": "Single",
          "description": "Whole-invocation concurrency policy: Single, Restart, Queued or Parallel.",
          "label": "Mode"
        },
        "manual": {
          "type": "boolean",
          "default": true,
          "description": "Whether this trigger exposes a manual run action.",
          "label": "Manual"
        },
        "startup": {
          "type": "boolean",
          "description": "Optional override of startup behavior; when omitted, follows the trigger type.",
          "label": "Startup"
        },
        "entitiesExpression": {
          "type": "string",
          "description": "Optional C# expression overriding legacy entity subscriptions.",
          "label": "Entities expression"
        },
        "schedulesExpression": {
          "type": "string",
          "description": "Optional C# expression overriding legacy schedules.",
          "label": "Schedules expression"
        },
        "at": {
          "type": "string",
          "description": "Once-only ISO timestamp with explicit UTC offset or Z.",
          "label": "At",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]{1,7})?)?(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])",
          "format": "date-time-offset"
        }
      },
      "inputs": {},
      "outputs": {
        "data": {
          "type": "object",
          "description": "Snapshot of the native or legacy trigger payload for this invocation.",
          "label": "Trigger data"
        }
      },
      "execution": [
        "next"
      ],
      "runtimeVersions": [
        5
      ]
    },
    "condition": {
      "label": "State condition",
      "category": "Hass",
      "description": "Branch on an entity state.",
      "minGraphVersion": 5,
      "config": {
        "state": {
          "type": "string",
          "required": true,
          "description": "Expected raw entity state string.",
          "label": "State"
        }
      },
      "inputs": {
        "entity": {
          "types": [
            "entity_id"
          ],
          "required": true,
          "description": "Entity whose state is compared with the configured state.",
          "label": "Entity"
        }
      },
      "outputs": {},
      "execution": [
        "true",
        "false",
        "error"
      ],
      "runtimeVersions": [
        5
      ]
    },
    "service": {
      "label": "Call service",
      "category": "Hass",
      "description": "Call a service with typed target and data; capture its response.",
      "minGraphVersion": 5,
      "config": {
        "service": {
          "type": "string",
          "required": true,
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
          "description": "Service identifier in domain.service form.",
          "label": "Service"
        }
      },
      "inputs": {
        "target": {
          "types": [
            "object"
          ],
          "required": false,
          "description": "Home Assistant service target object, such as entity_id, device_id or area_id.",
          "default": {
            "kind": "literal",
            "type": "object",
            "value": {}
          },
          "label": "Target"
        },
        "data": {
          "types": [
            "object"
          ],
          "required": false,
          "description": "Parameters passed to the selected service.",
          "default": {
            "kind": "literal",
            "type": "object",
            "value": {}
          },
          "label": "Service data"
        }
      },
      "outputs": {
        "response": {
          "type": "object",
          "description": "Home Assistant service response object after the call completes.",
          "label": "Response"
        }
      },
      "execution": [
        "next",
        "error"
      ],
      "runtimeVersions": [
        5
      ]
    },
    "delay": {
      "label": "Delay",
      "category": "Flow",
      "description": "Wait for the given seconds.",
      "minGraphVersion": 5,
      "config": {},
      "inputs": {
        "seconds": {
          "types": [
            "number"
          ],
          "required": true,
          "description": "Duration to wait before continuing.",
          "min": 0,
          "max": 4294967.294,
          "default": {
            "kind": "literal",
            "type": "number",
            "value": 60
          },
          "label": "Seconds"
        }
      },
      "outputs": {},
      "execution": [
        "next",
        "error"
      ],
      "runtimeVersions": [
        5
      ]
    },
