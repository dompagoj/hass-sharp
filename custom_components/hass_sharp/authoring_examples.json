      "version": 5,
      "name": "Sunset lights",
      "nodes": [
        {
          "id": "sunset",
          "kind": "trigger",
          "label": "At sunset",
          "config": {
            "type": "ha",
            "manual": true,
            "trigger": {
              "trigger": "sun",
              "event": "sunset",
              "offset": "-00:15:00"
            }
          }
        },
        {
          "id": "lights",
          "kind": "service",
          "label": "Living room lights on",
          "config": {
            "service": "light.turn_on",
            "target": {
              "kind": "literal",
              "type": "entity_id:light",
              "value": "light.living_room"
            },
            "fields": {
              "brightness_pct": {
                "kind": "literal",
                "type": "number",
                "value": 60
              },
              "color_temp_kelvin": {
                "kind": "literal",
                "type": "number",
                "value": 2700
              },
              "transition": {
                "kind": "literal",
                "type": "number",
                "value": 5
              }
            },
            "returnResponse": false
          }
        }
      ],
      "edges": [
        {
          "id": "flow",
          "source": "sunset",
          "target": "lights",
          "port": "next"
        }
      ]
    },
    {
      "version": 5,
      "name": "Heater off after 30 minutes",
      "nodes": [
        {
          "id": "heating",
          "kind": "trigger",
          "label": "Heating for 30 minutes",
          "config": {
            "type": "ha",
            "trigger": {
              "trigger": "state",
              "entity_id": "climate.bathroom",
              "to": "heat",
              "for": {
                "minutes": 30
              }
            }
          }
        },
        {
          "id": "off",
          "kind": "service",
          "label": "Heater off",
          "config": {
            "service": "climate.set_hvac_mode",
            "fields": {
              "hvac_mode": {
                "kind": "literal",
                "type": "string",
                "value": "off"
              }
            },
            "returnResponse": false
          }
        },
        {
          "id": "name",
          "kind": "entity_field",
          "label": "Heater name",
          "config": {
            "field": "attribute",
            "attribute": "friendly_name",
            "type": "string"
          }
        },
        {
          "id": "notify",
          "kind": "service",
          "label": "Notify",
          "config": {
            "service": "persistent_notification.create",
            "fields": {
              "title": {
                "kind": "unset"
              },
              "message": {
                "kind": "literal",
                "type": "string",
                "value": "It was heating for 30 minutes and has been switched off."
              }
            },
            "returnResponse": false
          }
        }
      ],
      "edges": [
        {
          "id": "flow-off",
          "source": "heating",
          "target": "off",
          "port": "next"
        },
        {
          "id": "flow-notify",
          "source": "off",
          "target": "notify",
          "port": "next"
        },
        {
          "id": "heater-target",
          "kind": "data",
          "source": "heating",
          "sourcePort": "entity_id",
          "target": "off",
          "targetPort": "target"
        },
        {
          "id": "heater-state",
          "kind": "data",
          "source": "heating",
          "sourcePort": "to_state",
          "target": "name",
          "targetPort": "entity"
        },
        {
          "id": "heater-title",
          "kind": "data",
          "source": "name",
          "sourcePort": "value",
          "target": "notify",
          "targetPort": "field:title"
        }
      ]
