<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- HassSharp.xml beside the assembly: the summaries a type's definition shows in the editor (TypeDefinitions.cs).
             Members without a doc comment, or with parameters it does not describe, are not reported. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0"/>
        <!-- Pinned with manifest.json. On an upgrade, re-check what PythonNetAssemblies.cs relies on (AssemblyManager.lhandler). -->
        <PackageReference Include="pythonnet" Version="3.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="../visual_node_catalog.json" LogicalName="HassSharp.visual_node_catalog.json" />
    </ItemGroup>

</Project>
